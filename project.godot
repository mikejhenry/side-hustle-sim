; Engine configuration file.
; Made for Godot 4.7 (also runs on 4.3+).

config_version=5

[application]

config/name="Side Hustle Sim"
config/description="Grind gig apps, pay your bills, upgrade your ride and your crib."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Gigs="*res://scripts/autoload/gigs.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=1
